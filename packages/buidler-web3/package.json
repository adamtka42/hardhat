{
  "name": "@theqrl/hardhat-web3",
  "version": "1.3.3",
  "author": "The QRL contributors",
  "license": "MIT",
  "homepage": "https://theqrl.org",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "description": "QRL Hardhat plugin for using @theqrl/web3",
  "keywords": [
    "qrl",
    "post-quantum",
    "smart-contracts",
    "hardhat",
    "hardhat-plugin",
    "web3",
    "web3.js",
    "hyperion"
  ],
  "scripts": {
    "lint:fix": "node ../../node_modules/prettier/bin-prettier.js --write \"src/**/*.{js,ts}\" \"test/**/*.{js,ts}\" && npm run lint-src -- --fix && npm run lint-tests -- --fix",
    "lint": "npm run lint-src && npm run lint-tests",
    "lint-tests": "node ../../node_modules/tslint/bin/tslint --config tslint.json --project ./tsconfig.json",
    "lint-src": "node ../../node_modules/tslint/bin/tslint --config tslint.json --project src/tsconfig.json",
    "test": "node ../../node_modules/mocha/bin/mocha --recursive \"test/**/*.ts\" --recursive \"web3-lazy-object-tests/*.js\" --exit ",
    "build": "node ../../node_modules/typescript/bin/tsc --build src && node -e \"require(\\\"fs\\\").copyFileSync(\\\"src/type-extensions.d.ts\\\", \\\"dist/type-extensions.d.ts\\\")\"",
    "build-test": "node ../../node_modules/typescript/bin/tsc --build .",
    "clean": "node ../../node_modules/rimraf/bin.js dist build-test"
  },
  "files": [
    "dist/",
    "src/",
    "LICENSE",
    "README.md"
  ],
  "devDependencies": {
    "@theqrl/hardhat": "^1.3.3",
    "@theqrl/web3": "^0.5.0",
    "@types/chai": "^4.2.0",
    "chai": "^4.2.0"
  },
  "peerDependencies": {
    "@theqrl/hardhat": "^1.3.3",
    "@theqrl/web3": "^0.5.0"
  }
}
