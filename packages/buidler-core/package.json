{
  "name": "@theqrl/hardhat",
  "version": "1.3.3",
  "author": "The QRL contributors",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://theqrl.org",
  "repository": "github:cyyber/hardhat",
  "main": "internal/lib/hardhat-lib.js",
  "types": "internal/lib/hardhat-lib.d.ts",
  "description": "QRL smart contract development tooling based on upstream v1.3.3.",
  "keywords": [
    "qrl",
    "post-quantum",
    "smart-contracts",
    "hardhat",
    "blockchain",
    "dapps",
    "javascript",
    "tooling",
    "task-runner",
    "hyperion"
  ],
  "bin": {
    "hardhat": "internal/cli/cli.js"
  },
  "engines": {
    "node": ">=8.2.0"
  },
  "scripts": {
    "lint:fix": "node ../../node_modules/prettier/bin-prettier.js --write \"src/**/*.{js,ts}\" \"test/**/*.{js,ts}\" && npm run lint-src -- --fix && npm run lint-tests -- --fix",
    "lint": "npm run lint-src && npm run lint-tests",
    "lint-tests": "node -r ts-node/register ../../node_modules/tslint/bin/tslint --config tslint.json --project ./tsconfig.json",
    "lint-src": "node -r ts-node/register ../../node_modules/tslint/bin/tslint --config tslint.json --project src/tsconfig.json",
    "test": "node ../../node_modules/mocha/bin/mocha --recursive \"test/**/*.ts\"",
    "coverage": "node ../../node_modules/nyc/bin/nyc.js ../../node_modules/mocha/bin/mocha --recursive \"test/**/*.ts\"",
    "build": "node ../../node_modules/typescript/bin/tsc --build src",
    "build-test": "node ../../node_modules/typescript/bin/tsc --build .",
    "clean": "node ../../node_modules/rimraf/bin.js builtin-tasks internal *.d.ts *.map *.js build-test tsconfig.tsbuildinfo"
  },
  "files": [
    "builtin-tasks/",
    "internal/",
    "sample-project/",
    "src/",
    "*.d.ts",
    "*.d.ts.map",
    "*.js",
    "*.js.map",
    "LICENSE",
    "README.md",
    "recommended-gitignore.txt"
  ],
  "devDependencies": {
    "@types/chai": "^4.2.0",
    "@types/debug": "4.1.4",
    "@types/download": "^6.2.4",
    "@types/find-up": "^2.1.1",
    "@types/fs-extra": "^5.1.0",
    "@types/glob": "7.1.1",
    "@types/lodash": "4.14.123",
    "@types/node-fetch": "^2.3.7",
    "@types/semver": "^6.0.2",
    "@types/sinon": "^7.5.1",
    "@types/ws": "^7.2.1",
    "chai": "^4.2.0",
    "sinon": "^9.0.0",
    "time-require": "^0.1.2"
  },
  "dependencies": {
    "@theqrl/web3-qrl-accounts": "^0.5.0",
    "@types/bn.js": "^4.11.5",
    "@types/lru-cache": "^5.1.0",
    "ansi-escapes": "^4.3.0",
    "bn.js": "^4.11.8",
    "chalk": "^2.4.2",
    "debug": "^4.1.1",
    "deepmerge": "^2.1.0",
    "enquirer": "^2.3.0",
    "ethereum-cryptography": "^0.1.3",
    "find-up": "^2.1.0",
    "fp-ts": "1.19.3",
    "fs-extra": "^7.0.1",
    "glob": "^7.1.3",
    "io-ts": "1.10.4",
    "is-installed-globally": "^0.2.0",
    "js-sha3": "^0.8.0",
    "lodash": "^4.17.11",
    "mocha": "^7.1.2",
    "node-fetch": "^2.6.0",
    "raw-body": "^2.4.1",
    "semver": "^6.3.0",
    "slash": "^3.0.0",
    "source-map-support": "^0.5.13",
    "ts-essentials": "^2.0.7",
    "tsort": "0.0.1",
    "ws": "^7.2.1"
  },
  "optionalDependencies": {
    "@ledgerhq/hw-transport-node-hid": "^6.29.12"
  },
  "nyc": {
    "extension": [
      ".ts"
    ],
    "exclude": [
      "**/*.d.ts",
      "dev-build",
      "sample-project",
      "test",
      "coverage",
      ".nyc_output",
      "*.ts",
      "*.js",
      "internal",
      "builtin-tasks",
      "build-test"
    ],
    "reporter": [
      "text",
      "lcovonly"
    ],
    "all": true
  }
}
